# Template only. Copy the lines you need into .env (or into Vercel -> Settings -> Environment Variables),
# remove the leading "# " and fill in the value. Never leave a variable empty.

# Required
# TELEGRAM_BOT_TOKEN=<from @BotFather>
# GEMINI_API_KEY=<from Google AI Studio, starts with AQ.>
# TELEGRAM_NOTES_CHAT_ID=-1003976391640
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# CRON_SECRET=<long random string: python -c "import secrets; print(secrets.token_urlsafe(32))">

# Add after Meera sends /start to the bot
# MEERA_USER_ID=<her numeric Telegram id>

# Optional. The values shown are the built-in defaults; add one only to change it.
# REVIEW_CHAT_ID=<defaults to the notes channel (one chat); set to MEERA_USER_ID to review in a private chat>
# GEMINI_MODEL=gemini-3.7-flash
# GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.1-flash-lite
# TIMEZONE=Asia/Kolkata
# TRIAGE_SCHEDULE=MON,WED,FRI@08:00      (local polling only; on Vercel the schedule is in vercel.json)
# SHORTLIST_SIZE=4
# NEWS_LOOKBACK_DAYS=30
# NEWS_MAX_LOOKBACK_DAYS=60
# NEWS_TRUSTED_ONLY=true               (only cite publishers in config/news_sources.yaml)
# AUTO_DRAFT_ON_CAPTURE=true            (score each note on arrival; draft it if >= MIN_SHORTLIST_SCORE)
# MIN_SHORTLIST_SCORE=6
# AUTO_DRAFT_TOP_N=0                     (0 = Meera picks every note; don't change without her say-so)
# ALLOW_HASHTAGS=false
# CAPTURE_REACTION=false
# LOG_LEVEL=INFO
# DRAFT_TEMPERATURE=0.7
# TRIAGE_TEMPERATURE=0.2
# PRICE_INPUT_PER_M=0.30                 (USD per 1M tokens, cost estimates only)
# PRICE_OUTPUT_PER_M=2.50
# DB_PATH=data/app.db                    (local SQLite, used only when DATABASE_URL is not set)
