TELEGRAM_BOT_TOKEN=
TELEGRAM_NOTES_CHAT_ID=-1003976391640
MEERA_USER_ID=
# REVIEW_CHAT_ID defaults to MEERA_USER_ID (private chat with the bot)
REVIEW_CHAT_ID=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.1-flash-lite
TIMEZONE=Asia/Kolkata
TRIAGE_SCHEDULE=MON,WED,FRI@08:00
SHORTLIST_SIZE=4
NEWS_LOOKBACK_DAYS=14
# 0 = Meera picks every note (Judgment Protected). Do not change without her say-so.
AUTO_DRAFT_TOP_N=0
ALLOW_HASHTAGS=false
CAPTURE_REACTION=false
DB_PATH=data/app.db
LOG_LEVEL=INFO
DRAFT_TEMPERATURE=0.7
TRIAGE_TEMPERATURE=0.2
# USD per 1M tokens, used only for cost estimates. Check current Gemini pricing.
PRICE_INPUT_PER_M=0.30
PRICE_OUTPUT_PER_M=2.50
# Leave empty for long polling (default). Set to a public https URL to use webhook mode.
WEBHOOK_URL=
WEBHOOK_PORT=8443
