{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "server.py": {
      "maxDuration": 300,
      "excludeFiles": "{tests/**,.venv/**,**/__pycache__/**,Dockerfile,DEPLOY.md,CLAUDE.md}"
    }
  },
  "crons": [
    { "path": "/api/cron/triage", "schedule": "30 2 * * 1,3,5" },
    { "path": "/api/cron/weekly", "schedule": "30 12 * * 0" }
  ]
}
